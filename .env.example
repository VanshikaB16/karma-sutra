# ===================================================================
# KARMA SUTRA™ — Environment Configuration Template
# Divine Grievance & Resolution Office
# ===================================================================
# Copy this file to .env and configure your local or production values:
# cp .env.example .env

# Database Configuration (MySQL 8.0+)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=karma_sutra_db
DB_USER=root
DB_PASSWORD=

# Cosmic Web Server Ports
COSMIC_PORT=8108
VITE_PORT=5173

# Artificial Intelligence Engine Settings
# Supported Providers: GEMINI | GROQ | COSMIC_MOCK
AI_PROVIDER=GEMINI
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=20

# Google Gemini API Key (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (High-Speed Llama-3 70B, get free key at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Cosmic Bureaucracy Tuning
APP_DAILY_FREE_TICKET_QUOTA=10
APP_INITIAL_KARMA_POINTS=108
APP_ESCALATION_AUTO_DETECT=true
