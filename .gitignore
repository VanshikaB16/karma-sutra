# ===================================================================
# KARMA SUTRA™ — Professional .gitignore
# ===================================================================

# Environment & Secret Credentials (NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# Compiled Java Binaries & Maven Artifacts
target/
*.class
*.jar
*.war
*.ear
dependency-reduced-pom.xml

# Node.js & Frontend Dependencies
node_modules/
cosmic-3d/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.turbo/

# Vite Cache
.vite/
cosmic-3d/.vite/

# Local Database & Socket Runtime Files
/tmp/karma_sutra_db_data/
*.sock
*.sock.lock
mysqld.log
*.log

# OS & Editor Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
*.iml
.vscode/
*.sublime-project
*.sublime-workspace

# Local automation & capture scripts (workspace development only)
capture_*.mjs
test_*.mjs
